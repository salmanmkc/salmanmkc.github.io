---
import type { Featured } from '../data/featured';
interface Props { item: Featured }
const { item } = Astro.props;
const { title, kicker, blurb, video, poster, caption, note, links, tags, year } = item;
---
<article class="featured">
  <figure class="media">
    <video
      class="clip"
      src={video}
      poster={poster}
      controls
      muted
      loop
      playsinline
      preload="none"
      data-autoplay-in-view
      aria-label={`${title} — demo clip, no audio`}
    ></video>
    <figcaption>{caption}</figcaption>
  </figure>
  <div class="body">
    <p class="kicker">{kicker}</p>
    <h3>{title}</h3>
    <p class="blurb">{blurb}</p>
    {note && <p class="note">{note}</p>}
    <div class="meta">
      {year && <span class="year">{year}</span>}
      {tags && tags.map((t) => <span class="tag">{t}</span>)}
    </div>
    <div class="links">
      {links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
      ))}
    </div>
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 0;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .media {
    margin: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--line);
    background: var(--card);
  }
  .clip {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: contain;
    display: block;
    background: var(--media-bg);
  }
  figcaption {
    padding: 10px 14px 12px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--muted);
    background: var(--card);
  }
  .body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
  }
  .kicker {
    margin: 0 0 6px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h3 {
    margin: 0 0 10px;
    font-size: 21px;
    line-height: 1.25;
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .blurb {
    margin: 0;
    font-size: 14.5px;
    color: var(--body);
  }
  .note {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--muted);
    border-left: 2px solid var(--line);
    padding-left: 10px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 12px;
    color: var(--muted);
    margin: 16px 0 0;
  }
  .tag, .year {
    border: 1px solid var(--line);
    padding: 2px 8px;
    border-radius: 999px;
  }
  .year { background: var(--chip); }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .links a { border-bottom: 1px solid var(--line); }
  .links a:hover { border-bottom-color: var(--fg); }

  @media (max-width: 860px) {
    .featured { grid-template-columns: 1fr; }
    .media { border-right: none; border-bottom: 1px solid var(--line); }
    .body { padding: 20px 18px 22px; }
    h3 { font-size: 19px; }
  }
</style>
